# Copy to backend/.env and fill in. On Render, set these in the service's Environment tab.

# "production" on Render: HTTPS-only cookies and SECRET_KEY must be set.
ENVIRONMENT=development

# Random string used to sign session cookies:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase Postgres (Supabase > Connect). Locally the "Direct" URL works; on Render (IPv4 only)
# use the "Session pooler" URL. Always change the scheme to postgresql+psycopg://
#   direct: postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   pooler: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Storage (Project Settings > API Keys > service_role). Server-side only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Required with the pooler URL (it can only be derived from the direct URL).
SUPABASE_URL=https://<project-ref>.supabase.co
MEDIA_BUCKET=booktown
PDF_BUCKET=booktown

# Groq LLM used to score recommendations (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b       # recommendation scoring
# GROQ_FAST_MODEL=openai/gpt-oss-20b   # sentiment

# Razorpay (leave empty to disable online payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
