# Copy to backend/.env and fill in.

# Random string used to sign session cookies:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase Postgres (Project Settings > Database > Connection string, "Direct").
# Note: the direct host is IPv6-only; use the Session pooler URL on IPv4-only hosts.
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Storage (Project Settings > API Keys > service_role). Server-side only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: derived from DATABASE_URL when unset.
# SUPABASE_URL=https://<project-ref>.supabase.co
MEDIA_BUCKET=booktown
PDF_BUCKET=booktown

# Groq LLM used to score recommendations (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Razorpay (leave empty to disable online payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
